# Admin dashboard password (set in Cloudflare Pages → Environment variables)
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Public URL embedded in QR codes (e.g. https://your-site.pages.dev). Omit to use current origin.
# VITE_PUBLIC_SITE_URL=https://your-site.pages.dev

# --- One-time Cloudflare Pages env (NOT VITE_*): Save in admin → auto-commit to GitHub → redeploy (no KV) ---
# Create a GitHub fine-grained token with Contents read/write on this repo only.
# GITHUB_TOKEN=
# GITHUB_OWNER=digitalprint077-lang
# GITHUB_REPO=dastak
# GITHUB_BRANCH=main
# ADMIN_SYNC_KEY= same value as VITE_ADMIN_PASSWORD (optional; defaults to admin password)

# Privacy: CNIC from public forms is never persisted — see PRIVACY.md
