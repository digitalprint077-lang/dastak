# Admin dashboard password (set in Cloudflare Pages → Environment variables)
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Public URL embedded in QR codes (e.g. https://your-site.pages.dev). Omit to use current origin.
# VITE_PUBLIC_SITE_URL=https://your-site.pages.dev

# --- Cloudflare build (Dashboard → Builds → Build command) ---
# npm run deploy
# (Runs vite build + wrangler deploy so /api/* works — without this, Save only downloads JSON.)

# --- One-time Cloudflare env vars (Production, NOT in git): Save → auto-commit to GitHub (no KV) ---
# Cloudflare → Workers & Pages → dastak → Settings → Variables (Production tab):
#   GITHUB_TOKEN (Encrypt / Secret) — GitHub Contents read/write on repo dastak
#   ADMIN_SYNC_KEY (Encrypt / Secret) — MUST match admin login password (Worker runtime)
#   VITE_ADMIN_PASSWORD — same password (build-time, for login UI only)
# Build command: npm run deploy
# Owner/repo/branch default in wrangler.toml [vars].

# --- D1 (instant live save — preferred over GitHub publish) ---
# wrangler.toml binds dastak-certs → env.Dastak_binding (match Cloudflare Bindings UI).
# Apply schema once:
#   npx wrangler d1 execute dastak-certs --remote --file=./migrations/0001_init.sql
# One-time import from static JSON into D1 (logged-in admin, after deploy):
#   curl -X POST "https://YOUR-SITE/api/certificates?migrate=d1" -H "X-Admin-Sync-Key: YOUR_ADMIN_PASSWORD"

# Privacy: CNIC from public forms is never persisted — see PRIVACY.md
