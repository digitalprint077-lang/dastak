# Admin dashboard password (set in Cloudflare Pages → Environment variables)
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Public URL embedded in QR codes (e.g. https://your-site.pages.dev). Omit to use current origin.
# VITE_PUBLIC_SITE_URL=https://your-site.pages.dev

