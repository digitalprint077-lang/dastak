# Admin dashboard password (set in Cloudflare Pages → Environment variables)
VITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Public URL embedded in QR codes (e.g. https://your-site.pages.dev). Omit to use current origin.
# VITE_PUBLIC_SITE_URL=https://your-site.pages.dev

# --- Cloudflare build (Dashboard → Builds → Build command) ---
# npm run deploy
# (Runs vite build + wrangler deploy so /api/* works — without this, Save only downloads JSON.)

# --- One-time Cloudflare env vars (Production, NOT in git): Save → auto-commit to GitHub (no KV) ---
# Cloudflare → Workers & Pages → dastak → Settings → Variables (Production):
#   GITHUB_TOKEN = your token (Encrypt) — Contents read/write on repo dastak only
#   VITE_ADMIN_PASSWORD = admin login (also used to authorize Save → GitHub)
# Owner/repo/branch are in wrangler.toml; redeploy after adding GITHUB_TOKEN.

# Privacy: CNIC from public forms is never persisted — see PRIVACY.md
